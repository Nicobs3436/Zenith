# Local development default is http://localhost:8000 if this variable is omitted.
# Native builds (EAS) must use the deployed backend URL. The web build on Vercel uses /api
# (same-origin proxy defined in vercel.json, required for the httpOnly refresh cookie).
EXPO_PUBLIC_API_URL=https://<render-service>.onrender.com
# Optional: Sentry DSN (free plan). Empty = disabled.
EXPO_PUBLIC_SENTRY_DSN=
